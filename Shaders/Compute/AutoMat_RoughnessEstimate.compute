// AutoMat_RoughnessEstimate.compute
// Local variance-based Roughness estimation from color texture
// 2 kernels: CalcVariance → RemapRoughness
// Dispatch each: (texWidth/8, texHeight/8, 1)

#pragma kernel CalcVariance
#pragma kernel RemapRoughness

Texture2D<float4> _Input;
RWTexture2D<float4> _TempBuffer;  // Intermediate variance storage
RWTexture2D<float4> _Result;
int2 _TexSize;
int _BlockSize;
float _RemapMin;
float _RemapMax;
float _SaturationWeight;

float GetLuminance(float3 col)
{
    return 0.299 * col.r + 0.587 * col.g + 0.114 * col.b;
}

float3 RGBtoHSL(float3 rgb)
{
    float maxC = max(rgb.r, max(rgb.g, rgb.b));
    float minC = min(rgb.r, min(rgb.g, rgb.b));
    float delta = maxC - minC;

    float h = 0, s = 0, l = (maxC + minC) * 0.5;

    if (delta > 0.001)
    {
        s = (l < 0.5) ? (delta / (maxC + minC)) : (delta / (2.0 - maxC - minC));

        if (maxC == rgb.r)
            h = (rgb.g - rgb.b) / delta + (rgb.g < rgb.b ? 6.0 : 0.0);
        else if (maxC == rgb.g)
            h = (rgb.b - rgb.r) / delta + 2.0;
        else
            h = (rgb.r - rgb.g) / delta + 4.0;
        h /= 6.0;
    }

    return float3(h, s, l);
}

[numthreads(8, 8, 1)]
void CalcVariance(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    int half_block = (int)((uint)_BlockSize >> 1);
    float sum = 0.0;
    float sumSq = 0.0;
    float count = 0.0;

    for (int dy = -half_block; dy <= half_block; dy++)
    {
        for (int dx = -half_block; dx <= half_block; dx++)
        {
            int2 pos = clamp(int2(id.xy) + int2(dx, dy), int2(0, 0), _TexSize - int2(1, 1));
            float lum = GetLuminance(_Input[pos].rgb);
            sum += lum;
            sumSq += lum * lum;
            count += 1.0;
        }
    }

    float mean = sum / count;
    float variance = (sumSq / count) - (mean * mean);
    _TempBuffer[id.xy] = float4(variance, 0, 0, 1);
}

[numthreads(8, 8, 1)]
void RemapRoughness(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    float variance = _TempBuffer[id.xy].r;

    // Remap variance to 0..1
    float roughness = saturate((variance - _RemapMin) / max(_RemapMax - _RemapMin, 0.0001));

    // Saturation correction: low saturation + high luminance → lower roughness (metallic look)
    float3 hsl = RGBtoHSL(_Input[id.xy].rgb);
    float satCorrection = (1.0 - hsl.y) * hsl.z * _SaturationWeight;
    roughness = saturate(roughness - satCorrection);

    _Result[id.xy] = float4(roughness, roughness, roughness, 1.0);
}
