// MaskTex_LayerFlatten.compute
// Layer compositing with multiple blend modes for mask texture operations
// Dispatch: (texWidth/8, texHeight/8, 1)

#pragma kernel FlattenLayer

Texture2D<float4> _Bottom;
Texture2D<float4> _Top;
RWTexture2D<float4> _Result;
int2 _TexSize;
float _LayerOpacity;
int _BlendMode; // 0=Normal, 1=Multiply, 2=Add, 3=Subtract, 4=Overlay, 5=Screen, 6=ColorDodge, 7=ColorBurn, 8=SoftLight, 9=HardLight, 10=Difference, 11=Exclusion
Texture2D<float4> _MaskTex;
int _HasMask;

float OverlayChannel(float base, float blend)
{
    if (base < 0.5)
        return 2.0 * base * blend;
    else
        return 1.0 - 2.0 * (1.0 - base) * (1.0 - blend);
}

[numthreads(8, 8, 1)]
void FlattenLayer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    float4 bottom = _Bottom[id.xy];
    float4 top = _Top[id.xy];

    float effectiveAlpha = top.a * _LayerOpacity;

    if (_HasMask)
    {
        float4 maskVal = _MaskTex[id.xy];
        float m = (maskVal.r + maskVal.g + maskVal.b) / 3.0;
        effectiveAlpha *= m;
    }

    // Compute blended RGB
    float3 blended;

    if (_BlendMode == 0) // Normal
    {
        blended = top.rgb;
    }
    else if (_BlendMode == 1) // Multiply
    {
        blended = bottom.rgb * top.rgb;
    }
    else if (_BlendMode == 2) // Add
    {
        blended = min(bottom.rgb + top.rgb, 1.0);
    }
    else if (_BlendMode == 3) // Subtract
    {
        blended = max(bottom.rgb - top.rgb, 0.0);
    }
    else if (_BlendMode == 4) // Overlay
    {
        blended = float3(
            OverlayChannel(bottom.r, top.r),
            OverlayChannel(bottom.g, top.g),
            OverlayChannel(bottom.b, top.b));
    }
    else if (_BlendMode == 5) // Screen
    {
        blended = 1.0 - (1.0 - bottom.rgb) * (1.0 - top.rgb);
    }
    else if (_BlendMode == 6) // ColorDodge
    {
        blended = min(bottom.rgb / max(1.0 - top.rgb, 0.0001), 1.0);
    }
    else if (_BlendMode == 7) // ColorBurn
    {
        blended = 1.0 - min((1.0 - bottom.rgb) / max(top.rgb, 0.0001), 1.0);
    }
    else if (_BlendMode == 8) // SoftLight
    {
        float3 d = lerp(sqrt(bottom.rgb), bottom.rgb <= 0.25 ? ((16.0 * bottom.rgb - 12.0) * bottom.rgb + 4.0) * bottom.rgb : sqrt(bottom.rgb), step(0.25, bottom.rgb));
        blended = lerp(bottom.rgb - (1.0 - 2.0 * top.rgb) * bottom.rgb * (1.0 - bottom.rgb),
                       bottom.rgb + (2.0 * top.rgb - 1.0) * (d - bottom.rgb),
                       step(0.5, top.rgb));
    }
    else if (_BlendMode == 9) // HardLight
    {
        blended = float3(
            top.r < 0.5 ? 2.0 * bottom.r * top.r : 1.0 - 2.0 * (1.0 - bottom.r) * (1.0 - top.r),
            top.g < 0.5 ? 2.0 * bottom.g * top.g : 1.0 - 2.0 * (1.0 - bottom.g) * (1.0 - top.g),
            top.b < 0.5 ? 2.0 * bottom.b * top.b : 1.0 - 2.0 * (1.0 - bottom.b) * (1.0 - top.b));
    }
    else if (_BlendMode == 10) // Difference
    {
        blended = abs(bottom.rgb - top.rgb);
    }
    else if (_BlendMode == 11) // Exclusion
    {
        blended = bottom.rgb + top.rgb - 2.0 * bottom.rgb * top.rgb;
    }
    else
    {
        blended = top.rgb;
    }

    // Alpha compositing (pre-multiplied)
    float outAlpha = effectiveAlpha + bottom.a * (1.0 - effectiveAlpha);
    float3 outRgb;

    if (outAlpha > 0.0001)
        outRgb = (blended * effectiveAlpha + bottom.rgb * bottom.a * (1.0 - effectiveAlpha)) / outAlpha;
    else
        outRgb = float3(0, 0, 0);

    _Result[id.xy] = float4(outRgb, outAlpha);
}
