// MaskTex_BrushStamp.compute
// GPU-accelerated brush stamp operations for mask texture painting
// Dispatch over brush bounding box only: ((bboxW+7)/8, (bboxH+7)/8, 1)

#pragma kernel BrushStampPaint
#pragma kernel BrushStampErase
#pragma kernel BrushStampSmooth

Texture2D<float4> _Input;
RWTexture2D<float4> _Result;
int2 _TexSize;
float2 _BrushCenter;
float _BrushRadius;
float _BrushHardness;
float _BrushOpacity;
float _BrushStrength;
float _BrushPaintAlpha;
int _EraseRgb;
float4 _BrushColor;
int _UseColorMode;
int2 _BrushBBoxMin;

float BrushFalloff(float distance, float radius, float hardness)
{
    float t = distance / radius;
    if (t > 1.0) return 0.0;
    float inner = saturate(hardness * hardness);
    if (t < inner) return 1.0;
    float s = (t - inner) / (1.0 - inner + 0.0001);
    return 1.0 - s * s * (3.0 - 2.0 * s);
}

[numthreads(8, 8, 1)]
void BrushStampPaint(uint3 id : SV_DispatchThreadID)
{
    int2 texCoord = int2(id.xy) + _BrushBBoxMin;

    if (texCoord.x < 0 || texCoord.x >= _TexSize.x ||
        texCoord.y < 0 || texCoord.y >= _TexSize.y)
        return;

    float dist = distance(float2(texCoord), _BrushCenter);
    float falloff = BrushFalloff(dist, _BrushRadius, _BrushHardness);
    float alpha = falloff * _BrushOpacity;

    float4 src = _Input[texCoord];
    float4 target = _UseColorMode ? _BrushColor : float4(_BrushStrength, _BrushStrength, _BrushStrength, _BrushPaintAlpha);
    _Result[texCoord] = lerp(src, target, alpha);
}

[numthreads(8, 8, 1)]
void BrushStampErase(uint3 id : SV_DispatchThreadID)
{
    int2 texCoord = int2(id.xy) + _BrushBBoxMin;

    if (texCoord.x < 0 || texCoord.x >= _TexSize.x ||
        texCoord.y < 0 || texCoord.y >= _TexSize.y)
        return;

    float dist = distance(float2(texCoord), _BrushCenter);
    float falloff = BrushFalloff(dist, _BrushRadius, _BrushHardness);
    float alpha = falloff * _BrushOpacity;

    float4 src = _Input[texCoord];
    float4 target;
    if (_EraseRgb)
        target = float4(0, 0, 0, 0);
    else
        target = float4(src.rgb, 0);

    _Result[texCoord] = lerp(src, target, alpha);
}

[numthreads(8, 8, 1)]
void BrushStampSmooth(uint3 id : SV_DispatchThreadID)
{
    int2 texCoord = int2(id.xy) + _BrushBBoxMin;

    if (texCoord.x < 0 || texCoord.x >= _TexSize.x ||
        texCoord.y < 0 || texCoord.y >= _TexSize.y)
        return;

    float dist = distance(float2(texCoord), _BrushCenter);
    float falloff = BrushFalloff(dist, _BrushRadius, _BrushHardness);
    float alpha = falloff * _BrushOpacity;

    // 3x3 neighborhood average
    float4 sum = 0;
    int count = 0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 sampleCoord = int2(
                clamp(texCoord.x + dx, 0, _TexSize.x - 1),
                clamp(texCoord.y + dy, 0, _TexSize.y - 1));
            sum += _Input[sampleCoord];
            count++;
        }
    }
    float4 avg = sum / (float)count;

    float4 src = _Input[texCoord];
    _Result[texCoord] = lerp(src, avg, alpha);
}
