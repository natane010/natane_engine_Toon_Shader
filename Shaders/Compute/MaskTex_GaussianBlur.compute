// MaskTex_GaussianBlur.compute
// 2-pass separable Gaussian blur for MaskTex pipeline
// Dispatch each kernel: (texWidth/8, texHeight/8, 1)

#pragma kernel BlurH
#pragma kernel BlurV

Texture2D<float4> _Input;
RWTexture2D<float4> _Result;
int2 _TexSize;
int _BlurRadius;
float _Sigma;

float GaussWeight(int offset, float sigma)
{
    return exp(-0.5 * (offset * offset) / (sigma * sigma));
}

[numthreads(8, 8, 1)]
void BlurH(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    float4 sum = 0;
    float weightSum = 0;

    for (int i = -_BlurRadius; i <= _BlurRadius; i++)
    {
        int sx = clamp((int)id.x + i, 0, _TexSize.x - 1);
        float w = GaussWeight(i, _Sigma);
        sum += _Input[int2(sx, id.y)] * w;
        weightSum += w;
    }

    _Result[id.xy] = sum / weightSum;
}

[numthreads(8, 8, 1)]
void BlurV(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    float4 sum = 0;
    float weightSum = 0;

    for (int i = -_BlurRadius; i <= _BlurRadius; i++)
    {
        int sy = clamp((int)id.y + i, 0, _TexSize.y - 1);
        float w = GaussWeight(i, _Sigma);
        sum += _Input[int2(id.x, sy)] * w;
        weightSum += w;
    }

    _Result[id.xy] = sum / weightSum;
}
