// AutoMat_Luminance.compute
// RGB → Luminance (grayscale) conversion
// Dispatch: (texWidth/8, texHeight/8, 1)

#pragma kernel CSMain

Texture2D<float4> _Input;
RWTexture2D<float4> _Result;
int2 _TexSize;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y)
        return;

    float4 col = _Input[id.xy];
    float lum = 0.299 * col.r + 0.587 * col.g + 0.114 * col.b;
    _Result[id.xy] = float4(lum, lum, lum, 1.0);
}
